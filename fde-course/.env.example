# Optional: enables the "Ask the AI tutor" button. Without it the button explains it's disabled.
ANTHROPIC_API_KEY=

# --- Accounts (Supabase: Project Settings → API Keys) ---
# Leave empty for a local preview with every module unlocked.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used to record purchases from Stripe. Never expose to the browser.
SUPABASE_SECRET_KEY=

# --- Payments (Stripe: Developers → API keys / Webhooks) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: a Price you created in Stripe. Without it, checkout charges $149 USD inline (PRICE_USD in lib/config.ts).
STRIPE_PRICE_ID=

# Comma-separated emails that get full access without paying (for example, your own).
FREE_ACCESS_EMAILS=

# --- Site ---
# Public URL of the site (used for links and social previews).
NEXT_PUBLIC_SITE_URL=https://fdeplaybook.dev
