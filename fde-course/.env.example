# Optional: enables the AI tutor, rubric grading of written answers, and role-play practice.
# Without it those features explain they're switched off.
ANTHROPIC_API_KEY=
# Claude-backed actions (tutor answers, grades, role-play turns) each learner may make per day. Default 60.
# Needs supabase/migrations/0002_ai_usage.sql. Emails in FREE_ACCESS_EMAILS are exempt.
AI_DAILY_LIMIT=

# --- Accounts (Supabase: Project Settings → API Keys) ---
# Leave empty for a local preview with every module unlocked.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# (The Vercel–Supabase integration's NEXT_PUBLIC_SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY also work.)
# Server-only. Used to record purchases from Stripe. Never expose to the browser.
SUPABASE_SECRET_KEY=

# --- Payments (Stripe: Developers → API keys / Webhooks) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: a Price you created in Stripe. Without it, checkout charges $149 USD inline (PRICE_USD in lib/config.ts).
STRIPE_PRICE_ID=

# Comma-separated emails that get full access without paying (for example, your own).
FREE_ACCESS_EMAILS=

# Set to true on Vercel's Preview environment only to unlock every module on preview links
# for testing. Ignored on production.
PREVIEW_UNLOCK_ALL=

# Set to true at launch to show the three-track course (shared core, Applied AI Engineer,
# Applied AI Architect, FDE) on production. Dev and unlocked previews always show it.
TRACKS_LIVE=

# --- Site ---
# Public URL of the site (used for links and social previews).
NEXT_PUBLIC_SITE_URL=https://fdeplaybook.dev
